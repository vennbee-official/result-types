{
  "name": "result-types",
  "version": "1.0.0",
  "description": "Lightweight TypeScript Result type with Ok/Err constructors, type guards, transformers, and async utilities",
  "keywords": ["result", "result-type", "error-handling", "typescript", "ok", "err", "functional"],
  "license": "MIT",
  "author": "nidheesh-m-vakharia",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^6.0.0"
  }
}
